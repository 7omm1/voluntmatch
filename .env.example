APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Cuenta administradora (la crea database/seeders/AdminSeeder.php con "php artisan db:seed")
ADMIN_EMAIL=admin@voluntmatch.org
# Usa una contraseña larga y única; no la reutilices en otros sitios.
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Asistente virtual (chatbot)
# ---------------------------------------------------------------------------
# Sin credenciales funciona en modo local con RAG extractivo.
CHATBOT_ENABLED=true
CHATBOT_DRIVER=local
# Para usar un proveedor compatible con OpenAI:
# CHATBOT_DRIVER=openai
# CHATBOT_LLM_BASE_URL=https://api.openai.com/v1
# CHATBOT_LLM_API_KEY=
# CHATBOT_LLM_MODEL=gpt-4.1-mini
# CHATBOT_LLM_MODEL_SMALL=gpt-4.1-mini
# CHATBOT_LLM_MODEL_LARGE=gpt-4.1-mini
# CHATBOT_RAG_EMBEDDINGS=false
# CHATBOT_ROUTER_LLM=false

# Caché y límites. No caches respuestas personales.
CHATBOT_CACHE_ENABLED=true
CHATBOT_CACHE_TTL=300
CHATBOT_RATE_PER_MINUTE=12
CHATBOT_RATE_PER_DAY=120

# Observabilidad: las trazas guardan metadatos, no el texto.
CHATBOT_OBSERVABILITY=true
CHATBOT_STORE_CONTENT=true
CHATBOT_ANONYMIZE_IP=true

# Servidores MCP declarados como JSON. Por defecto vacío y desactivado.
# El token debe ir en su propia variable, nunca en el JSON versionado.
CHATBOT_MCP_ENABLED=false
CHATBOT_MCP_SERVERS={}
# CHATBOT_MCP_SERVERS={"docs":{"url":"https://mcp.ejemplo.org/mcp","token":"${CHATBOT_MCP_DOCS_TOKEN}","allowed_tools":["buscar_documento"],"audiences":["admin"],"read_only":true}}
# CHATBOT_MCP_DOCS_TOKEN=

# ---------------------------------------------------------------------------
# API del asistente y servidor MCP (salida)
# ---------------------------------------------------------------------------
# Emite tokens con: php artisan api:token "Nombre" --role=public
# o desde /admin/integraciones. Cada token tiene rol, scopes y cuota propia.
API_ENABLED=true
API_TOKEN_PREFIX=vm_
API_RATE_PER_MINUTE=60
API_RATE_PER_DAY=2000
MCP_SERVER_ENABLED=true
MCP_SERVER_NAME=voluntmatch

# ---------------------------------------------------------------------------
# Integraciones reales
# ---------------------------------------------------------------------------
# Correo: usa MAIL_* de arriba. Con MAIL_MAILER=log no sale a Internet.
INTEGRATION_MAIL_DRIVER=laravel
INTEGRATION_MAIL_FROM="no-reply@voluntmatch.org"
INTEGRATION_MAIL_FROM_NAME="VoluntMatch"
INTEGRATION_MAIL_PER_HOUR=20
INTEGRATION_MAIL_PER_DAY=60
INTEGRATION_MAIL_ALLOWED_DOMAINS=voluntmatch.org,voluntmatch.test

# Calendario: ics (invitación firmada, sin credenciales) o http (proveedor).
INTEGRATION_CALENDAR_DRIVER=ics
INTEGRATION_CALENDAR_TIMEZONE=America/Lima
# INTEGRATION_CALENDAR_DRIVER=http
# INTEGRATION_CALENDAR_URL=https://calendario.ejemplo.org/eventos
# INTEGRATION_CALENDAR_TOKEN=

# CRM: local (tabla crm_contacts) o http (HubSpot, Pipedrive, webhook).
INTEGRATION_CRM_DRIVER=local
# INTEGRATION_CRM_DRIVER=http
# INTEGRATION_CRM_URL=https://crm.ejemplo.org/contactos
# INTEGRATION_CRM_TOKEN=

# Mesa de ayuda: local (tickets internos) o http (Zendesk, Freshdesk…).
INTEGRATION_HELPDESK_DRIVER=local
INTEGRATION_HELPDESK_QUEUE=soporte-voluntmatch
# INTEGRATION_HELPDESK_DRIVER=http
# INTEGRATION_HELPDESK_URL=https://desk.ejemplo.org/tickets
# INTEGRATION_HELPDESK_TOKEN=

# Notificaciones: database | webhook | both | disabled.
INTEGRATION_NOTIFICATIONS_DRIVER=database
# INTEGRATION_NOTIFICATIONS_WEBHOOK_URL=https://hooks.slack.com/services/…

# Bitácora de entregas (sin cuerpos completos ni credenciales).
INTEGRATION_STORE_DELIVERIES=true
INTEGRATION_KEEP_DAYS=90


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

